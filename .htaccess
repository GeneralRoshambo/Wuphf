Options -Indexes
DirectoryIndex index.php
<FilesMatch "\.(sqlite|db|md)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(config|config\.local|lib|extras|pages|prompts|backup)\.php$">
  Require all denied
</FilesMatch>

AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
  <Files "sw.js">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
