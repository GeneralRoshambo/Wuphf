Options -Indexes
DirectoryIndex index.php
<FilesMatch "(\.(sqlite|db|md)|^build\.txt)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(config|config\.local|lib|extras|pages|prompts|backup|cms|cms_admin|schedule|digest|card|admin_tools)\.php$">
  Require all denied
</FilesMatch>

AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
  <Files "sw.js">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Pretty URLs: anything that is not a real file or folder goes to index.php, which looks up
# pages, blog posts, redirects and member profiles. If your host does not allow this, turn off
# "Pretty URLs" in Admin > SEO and the ?p=... addresses keep working.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # robots.txt and sitemap.xml are generated from Admin > SEO, even if an old file is still on the server.
  RewriteRule ^robots\.txt$ index.php?p=robots [L]
  RewriteRule ^sitemap\.xml$ index.php?p=sitemap [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)$ index.php?p=route&path=$1 [L,QSA]
</IfModule>

# Smaller pages: compress text on the way out
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>
